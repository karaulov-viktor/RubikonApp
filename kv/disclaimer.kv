<DisclaimerScreen>:
    md_bg_color: "#ffffff"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDLabel:
            text: "Отказ от ответственности"
            halign: "center"
            bold: True
            font_style: "Headline"
            role: "small"
            theme_text_color: "Custom"
            text_color: "#14532d"
            adaptive_height: True

        ScrollView:
            bar_width: dp(4)

            MDLabel:
                id: legal_text
                text: ""
                markup: True
                halign: "left"
                font_style: "Body"
                role: "medium"
                theme_text_color: "Custom"
                text_color: "#1b5e20"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width - dp(8), None
                padding: dp(4), dp(8)

        MDButton:
            pos_hint: {"center_x": 0.5}
            on_release: app.on_disclaimer_accept()
            MDButtonText:
                text: "Принять"

        MDButton:
            style: "outlined"
            pos_hint: {"center_x": 0.5}
            on_release: app.on_disclaimer_decline()
            MDButtonText:
                text: "Отказаться"