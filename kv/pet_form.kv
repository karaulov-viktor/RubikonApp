<PetFormScreen>:
    name: "pet_form"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1

        # ===== ШАПКА: стрелка назад + заголовок =====
        MDBoxLayout:
            orientation: "horizontal"
            adaptive_height: True
            padding: dp(8), dp(6)

            MDIconButton:
                icon: "arrow-left"
                icon_color: 0.13, 0.13, 0.13, 1
                on_release: root.manager.current = "profile"

            MDLabel:
                text: "Анкета питомца"
                font_style: "Title"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: 0.13, 0.13, 0.13, 1
                pos_hint: {"center_y": 0.5}

        # ===== КОНТЕНТ ФОРМЫ =====
        MDScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(20), dp(30), dp(20), dp(30)
                spacing: dp(24)

                # --- Кличка ---
                MDTextField:
                    id: field_name
                    mode: "outlined"

                    MDTextFieldHintText:
                        text: "Кличка питомца"

                    MDTextFieldMaxLengthText:
                        max_text_length: 20

                # --- Вид (выпадающий список) ---
                MDTextField:
                    id: field_species
                    mode: "outlined"
                    readonly: True
                    on_focus: root.open_species_menu(self, args[1])

                    MDTextFieldHintText:
                        text: "Вид"

                    MDTextFieldTrailingIcon:
                        icon: "chevron-down"

                # --- Порода (выпадающий список) ---
                MDTextField:
                    id: field_breed
                    mode: "outlined"
                    readonly: True
                    on_focus: root.open_breed_menu(self, args[1])

                    MDTextFieldHintText:
                        text: "Порода"

                    MDTextFieldTrailingIcon:
                        icon: "chevron-down"

                # --- Размер (выпадающий список) ---
                MDTextField:
                    id: field_size
                    mode: "outlined"
                    readonly: True
                    on_focus: root.open_size_menu(self, args[1])

                    MDTextFieldHintText:
                        text: "Размер"

                    MDTextFieldTrailingIcon:
                        icon: "chevron-down"

                # --- Возраст ---
                MDTextField:
                    id: field_age
                    mode: "outlined"
                    input_type: "number"
                    input_filter: "int"

                    MDTextFieldHintText:
                        text: "Возраст (лет)"

                    MDTextFieldMaxLengthText:
                        max_text_length: 3

                # --- Вес ---
                MDTextField:
                    id: field_weight
                    mode: "outlined"
                    input_type: "number"
                    input_filter: "float"

                    MDTextFieldHintText:
                        text: "Вес (кг)"

                    MDTextFieldMaxLengthText:
                        max_text_length: 6

                # --- Дополнительные сведения ---
                MDTextField:
                    id: field_history
                    mode: "outlined"

                    MDTextFieldHintText:
                        text: "Дополнительные сведения"

                    MDTextFieldMaxLengthText:
                        max_text_length: 200

                # --- Кнопка выбора фото ---
                MDButton:
                    style: "tonal"
                    size_hint_x: 1
                    on_release: root.choose_photo()

                    MDButtonText:
                        text: "Выбрать фото"

                # --- Статус фото ---
                MDLabel:
                    id: label_photo
                    text: "Фото не выбрано"
                    theme_text_color: "Secondary"
                    adaptive_height: True
                    halign: "center"

                # --- Кнопка "Сохранить" (в самом низу) ---
                MDButton:
                    style: "filled"
                    size_hint_x: 1
                    on_release: root.save_pet()

                    MDButtonText:
                        text: "Сохранить"