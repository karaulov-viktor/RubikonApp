#:import T models.theme

<PetFormScreen>:
    md_bg_color: T.BG

    MDBoxLayout:
        orientation: "vertical"

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [dp(16), dp(16), dp(16), dp(24)]
                spacing: dp(10)

                MDBoxLayout:
                    size_hint_y: None
                    height: "48dp"

                    MDIconButton:
                        icon: "arrow-left"
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN
                        on_release: root.cancel()

                    MDLabel:
                        id: form_title
                        text: "Новый питомец"
                        font_style: "Headline"
                        role: "small"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        valign: "middle"

                # --- Имя ---
                MDTextField:
                    id: f_name
                    mode: "filled"
                    size_hint_y: None
                    height: "56dp"
                    MDTextFieldHintText:
                        text: "Кличка питомца *"

                # --- Вид ---
                MDBoxLayout:
                    size_hint_y: None
                    height: "52dp"
                    spacing: dp(10)

                    MDLabel:
                        text: "Вид"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_SUB
                        valign: "middle"
                        size_hint_x: 0.25

                    Spinner:
                        id: f_species
                        text: "Кошка"
                        values: ["Кошка", "Собака", "Птица", "КРС", "Свинья", "МРС", "Лошадь"]
                        size_hint_x: 0.75
                        background_normal: ""
                        background_down: ""
                        background_color: T.GREEN_SOFT
                        color: T.GREEN
                        bold: True

                # --- Дата рождения: день / месяц / год ---
                MDLabel:
                    text: "Дата рождения (вместо возраста — возраст посчитаем сами)"
                    theme_text_color: "Custom"
                    text_color: T.TEXT_SUB
                    size_hint_y: None
                    height: "24dp"

                MDBoxLayout:
                    size_hint_y: None
                    height: "52dp"
                    spacing: dp(10)

                    Spinner:
                        id: sp_day
                        text: "1"
                        values: []
                        background_normal: ""
                        background_down: ""
                        background_color: T.GREEN_SOFT
                        color: T.GREEN
                        bold: True

                    Spinner:
                        id: sp_month
                        text: "1"
                        values: []
                        background_normal: ""
                        background_down: ""
                        background_color: T.GREEN_SOFT
                        color: T.GREEN
                        bold: True

                    Spinner:
                        id: sp_year
                        text: ""
                        values: []
                        background_normal: ""
                        background_down: ""
                        background_color: T.GREEN_SOFT
                        color: T.GREEN
                        bold: True

                # --- Порода ---
                MDTextField:
                    id: f_breed
                    mode: "filled"
                    size_hint_y: None
                    height: "56dp"
                    MDTextFieldHintText:
                        text: "Порода"

                # --- Фото ---
                MDCard:
                    orientation: "horizontal"
                    md_bg_color: T.GREEN_SOFT
                    radius: [dp(12)]
                    padding: dp(12)
                    size_hint_y: None
                    height: "52dp"
                    spacing: dp(8)
                    on_release: root.choose_photo()

                    MDLabel:
                        id: photo_hint
                        text: "Фото не выбрано"
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        valign: "middle"

                    MDIconButton:
                        icon: "camera-outline"
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN

                # --- Кнопки ---
                MDButton:
                    id: btn_save
                    style: "filled"
                    size_hint_y: None
                    height: "48dp"
                    on_release: root.save()
                    MDButtonText:
                        text: "Сохранить"

                MDButton:
                    style: "text"
                    size_hint_y: None
                    height: "40dp"
                    on_release: root.cancel()
                    MDButtonText:
                        text: "Отмена"
