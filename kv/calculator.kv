#:import C models.theme

<CalculatorScreen>
    id: calculator_screen
    canvas.before:
        Color:
            rgba: C.BG
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"

        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14)
            spacing: dp(2)
            md_bg_color: C.BG
            theme_bg_color: "Custom"

            MDLabel:
                text: "Калькулятор дозировок"
                font_style: "Title"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: C.BRAND_GREEN

            MDLabel:
                text: "Объём инъекции или число таблеток — по базе препаратов"
                font_style: "Body"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: C.TEXT_SUB

        MDDivider:
            size_hint_y: None
            height: dp(1)

        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(14)

                MDLabel:
                    text: root.formula_text
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: C.TEXT_SUB

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(8)
                    md_bg_color: C.CARD
                    line_color: C.BRAND_GREEN_BORDER
                    radius: [dp(14)]
                    padding: dp(14)
                    theme_bg_color: "Custom"
                    theme_line_color: "Custom"

                    MDTextField:
                        id: drug_field
                        mode: "filled"
                        readonly: True
                        on_focus: root.open_drug_menu() if self.focus else None
                        theme_bg_color: "Custom"
                        fill_color_normal: 0, 0, 0, 0
                        fill_color_focus: 0, 0, 0, 0
                        theme_line_color: "Custom"
                        line_color_normal: C.BRAND_GREEN_BORDER
                        line_color_focus: C.BRAND_GREEN
                        theme_text_color: "Custom"
                        text_color_normal: C.TEXT_MAIN
                        text_color_focus: C.BRAND_GREEN

                        MDTextFieldLeadingIcon:
                            icon: "pill"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.BRAND_GREEN
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldTrailingIcon:
                            icon: "menu-down"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.TEXT_SUB
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldHintText:
                            text: "Препарат (или ручной расчёт)"

                    MDLabel:
                        text: root.drug_info_text
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_MAIN
                        opacity: 1 if root.drug_info_text else 0

                    MDLabel:
                        text: root.course_text
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB
                        opacity: 1 if root.course_text else 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                    md_bg_color: C.CARD
                    line_color: C.BRAND_GREEN_BORDER
                    radius: [dp(14)]
                    padding: dp(14)
                    theme_bg_color: "Custom"
                    theme_line_color: "Custom"

                    MDTextField:
                        id: weight_field
                        mode: "filled"
                        theme_bg_color: "Custom"
                        fill_color_normal: 0, 0, 0, 0
                        fill_color_focus: 0, 0, 0, 0
                        theme_line_color: "Custom"
                        line_color_normal: C.BRAND_GREEN_BORDER
                        line_color_focus: C.BRAND_GREEN
                        theme_text_color: "Custom"
                        text_color_normal: C.TEXT_MAIN
                        text_color_focus: C.BRAND_GREEN

                        MDTextFieldLeadingIcon:
                            icon: "weight-kilogram"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.BRAND_GREEN
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldHintText:
                            text: "Вес животного, кг"

                    MDTextField:
                        id: dose_field
                        mode: "filled"
                        size_hint_y: None
                        height: dp(56) if root.dose_field_visible else 0
                        opacity: 1 if root.dose_field_visible else 0
                        theme_bg_color: "Custom"
                        fill_color_normal: 0, 0, 0, 0
                        fill_color_focus: 0, 0, 0, 0
                        theme_line_color: "Custom"
                        line_color_normal: C.BRAND_GREEN_BORDER
                        line_color_focus: C.BRAND_GREEN
                        theme_text_color: "Custom"
                        text_color_normal: C.TEXT_MAIN
                        text_color_focus: C.BRAND_GREEN

                        MDTextFieldLeadingIcon:
                            icon: "medical-bag"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.BRAND_GREEN
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldHintText:
                            text: root.dose_hint

                    MDTextField:
                        id: conc_field
                        mode: "filled"
                        size_hint_y: None
                        height: dp(56) if root.conc_field_visible else 0
                        opacity: 1 if root.conc_field_visible else 0
                        theme_bg_color: "Custom"
                        fill_color_normal: 0, 0, 0, 0
                        fill_color_focus: 0, 0, 0, 0
                        theme_line_color: "Custom"
                        line_color_normal: C.BRAND_GREEN_BORDER
                        line_color_focus: C.BRAND_GREEN
                        theme_text_color: "Custom"
                        text_color_normal: C.TEXT_MAIN
                        text_color_focus: C.BRAND_GREEN

                        MDTextFieldLeadingIcon:
                            icon: "test-tube"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.BRAND_GREEN
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldHintText:
                            text: "Концентрация препарата, мг/мл"

                    MDTextField:
                        id: tab_field
                        mode: "filled"
                        size_hint_y: None
                        height: dp(56) if root.tab_field_visible else 0
                        opacity: 1 if root.tab_field_visible else 0
                        theme_bg_color: "Custom"
                        fill_color_normal: 0, 0, 0, 0
                        fill_color_focus: 0, 0, 0, 0
                        theme_line_color: "Custom"
                        line_color_normal: C.BRAND_GREEN_BORDER
                        line_color_focus: C.BRAND_GREEN
                        theme_text_color: "Custom"
                        text_color_normal: C.TEXT_MAIN
                        text_color_focus: C.BRAND_GREEN

                        MDTextFieldLeadingIcon:
                            icon: "pill"
                            theme_icon_color: "Custom"
                            icon_color_normal: C.BRAND_GREEN
                            icon_color_focus: C.BRAND_GREEN

                        MDTextFieldHintText:
                            text: "Содержание таблетки, мг"

                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(12)

                    MDButton:
                        style: "filled"
                        theme_bg_color: "Custom"
                        md_bg_color: C.BRAND_GREEN
                        on_release: root.calculate()

                        MDButtonText:
                            text: "Рассчитать"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDButton:
                        style: "text"
                        on_release: root.reset()

                        MDButtonText:
                            text: "Сбросить"
                            theme_text_color: "Custom"
                            text_color: C.BRAND_GREEN

                MDLabel:
                    text: root.error_text
                    font_style: "Body"
                    theme_text_color: "Custom"
                    text_color: C.DANGER
                    opacity: 1 if root.error_text else 0
                    size_hint_y: None
                    height: dp(22) if root.error_text else 0

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(4)
                    md_bg_color: C.BRAND_GREEN_SOFT
                    radius: [dp(14)]
                    padding: dp(16)
                    theme_bg_color: "Custom"

                    MDLabel:
                        text: root.result_a_title
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB

                    MDLabel:
                        text: root.result_a_value
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.BRAND_GREEN

                    MDLabel:
                        text: root.result_b_title
                        font_style: "Body"
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB
                        size_hint_y: None
                        height: dp(22) if root.result_b_visible else 0
                        opacity: 1 if root.result_b_visible else 0

                    MDLabel:
                        text: root.result_b_value
                        font_style: "Headline"
                        theme_text_color: "Custom"
                        text_color: C.BRAND_GREEN
                        size_hint_y: None
                        height: dp(32) if root.result_b_visible else 0
                        opacity: 1 if root.result_b_visible else 0

                    MDLabel:
                        text: root.hint_text
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB
                        opacity: 1 if root.hint_text else 0

                MDLabel:
                    text: "Совет: сверяйте результат с инструкцией к препарату. Набирайте шприц подходящего объёма; таблетку делите только если это разрешено инструкцией."
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: C.TEXT_SUB