# Калькулятор дозировок — RubikonApp
# Спринт 2, пункт №7 (замена заглушки)
#
# ВАЖНО (правила проекта):
#   - только ПРОБЕЛЫ, 4 пробела на уровень вложенности (табы запрещены!)
#   - составные виджеты KivyMD 2.0.1.dev0: тексты полей и кнопок —
#     обязательно вложенные классы (MDTextFieldHintText, MDButtonText)
#
# ЦВЕТА (по замечанию пользователя: шапка и фон должны быть БЕЛЫМИ):
#   - фон экрана: явный белый 1,1,1,1 через canvas.before (НЕ
#     app.theme_cls.backgroundColor — в сборке KivyMD на машинах
#     пользователя он разрешается в чёрный);
#   - шапка: белая, тёмный заголовок, серый подзаголовок;
#   - акценты (кнопка результата, цифры результата) — зелёные #177300.

<CalculatorScreen>
    id: calculator_screen
    # Явный белый фон, рисуется ПОД содержимым (canvas.before)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"

        # ----------------------------------------------------------
        # Шапка — БЕЛАЯ, тёмный заголовок, снизу тонкая линия
        # ----------------------------------------------------------
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14)
            spacing: dp(2)
            md_bg_color: 1, 1, 1, 1

            MDLabel:
                text: "Калькулятор дозировок"
                font_style: "Title"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: 0.13, 0.13, 0.13, 1

            MDLabel:
                text: "Разовая доза и объём препарата для инъекции"
                font_style: "Body"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: 0.45, 0.45, 0.45, 1

        MDDivider:
            size_hint_y: None
            height: dp(1)

        # ----------------------------------------------------------
        # Содержимое (прокручивается на маленьких экранах)
        # ----------------------------------------------------------
        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(14)

                # Формула-подсказка: из чего складывается расчёт
                MDLabel:
                    text: "Объём, мл = Вес, кг × Доза, мг/кг ÷ Концентрация, мг/мл"
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 0.45, 0.45, 0.45, 1

                # --------------------------------------------------
                # Блок ввода (серая карточка)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                    md_bg_color: 0.97, 0.97, 0.97, 1
                    radius: [dp(12)]
                    padding: dp(14)

                    MDTextField:
                        id: weight_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "weight-kilogram"

                        MDTextFieldHintText:
                            text: "Вес животного, кг"

                    MDTextField:
                        id: dose_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "medical-bag"

                        MDTextFieldHintText:
                            text: "Дозировка препарата, мг/кг"

                    MDTextField:
                        id: conc_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "test-tube"

                        MDTextFieldHintText:
                            text: "Концентрация препарата, мг/мл"

                # --------------------------------------------------
                # Кнопки
                # --------------------------------------------------
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(12)

                    MDButton:
                        style: "filled"
                        on_release: root.calculate()

                        MDButtonText:
                            text: "Рассчитать"

                    MDButton:
                        style: "text"
                        on_release: root.reset()

                        MDButtonText:
                            text: "Сбросить"

                # --------------------------------------------------
                # Ошибка (видна только когда error_text непустой;
                # высота 0 без ошибки — чтобы не оставлять дыру в макете)
                # --------------------------------------------------
                MDLabel:
                    text: root.error_text
                    font_style: "Body"
                    theme_text_color: "Custom"
                    text_color: 0.702, 0.149, 0.118, 1
                    opacity: 1 if root.error_text else 0
                    size_hint_y: None
                    height: dp(22) if root.error_text else 0

                # --------------------------------------------------
                # Результат (светло-зелёная карточка)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(4)
                    md_bg_color: 0.906, 0.937, 0.878, 1
                    radius: [dp(12)]
                    padding: dp(16)

                    MDLabel:
                        text: "Нужно действующего вещества"
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.4, 0.33, 1

                    MDLabel:
                        text: root.result_mg
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 0.0902, 0.451, 0.0, 1

                    MDLabel:
                        text: "Объём препарата в шприц"
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.4, 0.33, 1

                    MDLabel:
                        text: root.result_ml
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 0.0902, 0.451, 0.0, 1

                # Совет под результатом
                MDLabel:
                    text: "Совет: набирайте шприц подходящего объёма и сверяйтесь с инструкцией к препарату."
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: 0.55, 0.55, 0.5, 1
