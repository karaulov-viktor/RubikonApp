#:import T models.theme

# pet_detail.kv — личная страница питомца.
#
# Уроки прошлых пакетов:
#  - все карточки: md_bg_color T.CARD + elevation 0 ЯВНО (у части
#    установок KivyMD 2.0.1.dev0 карточки рисуются с тонировкой);
#  - никаких фиксированных высот у многострочных label — высота
#    привязана к texture_size (иначе текст наезжает на соседей);
#  - формы: короткие подсказки + свой ряд, чтобы поля не сжимались
#    и текст подсказок не вылезал в соседнее поле.

<PetDetailScreen>:
    md_bg_color: T.BG

    MDBoxLayout:
        orientation: "vertical"

        ScrollView:
            do_scroll_x: False
            bar_width: 4

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: [0, 0, 0, "24dp"]

                # === АВАТАР НА ВСЮ ШИРИНУ ===
                FloatLayout:
                    size_hint_y: None
                    height: "260dp"

                    FitImage:
                        id: hdr_avatar
                        source: "img/logo.png"
                        size_hint: 1, 1
                        pos_hint: {"x": 0, "y": 0}
                        radius: [0, 0, 0, 0]

                    MDIconButton:
                        icon: "arrow-left"
                        pos_hint: {"x": 0.02, "top": 0.96}
                        md_bg_color: T.WHITE
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN
                        on_release: root.back()

                    MDIconButton:
                        icon: "pencil"
                        pos_hint: {"right": 0.985, "top": 0.96}
                        md_bg_color: T.WHITE
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN
                        on_release: root.edit_pet()

                    MDIconButton:
                        icon: "trash-can-outline"
                        pos_hint: {"right": 0.985, "top": 0.72}
                        md_bg_color: T.WHITE
                        theme_icon_color: "Custom"
                        icon_color: T.DANGER
                        on_release: root.confirm_delete_pet()

                # === ИНФОРМАЦИЯ ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(16)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    height: "120dp"
                    spacing: dp(2)

                    MDLabel:
                        id: l_name
                        text: "—"
                        font_style: "Headline"
                        role: "medium"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        size_hint_y: None
                        height: "34dp"

                    MDLabel:
                        id: l_species
                        text: "—"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_SUB
                        size_hint_y: None
                        height: "22dp"

                    MDLabel:
                        id: l_line3
                        text: "—"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_SUB
                        size_hint_y: None
                        height: "22dp"

                # === ЛЕЧЕНИЕ И НАЗНАЧЕНИЯ (старый функционал) ===
                MDCard:
                    orientation: "horizontal"
                    md_bg_color: T.GREEN_SOFT
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    height: "56dp"
                    spacing: dp(8)
                    ripple_behavior: True
                    on_release: root.open_treatment()

                    MDIcon:
                        icon: "medical-bag"
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN
                        size_hint_x: None
                        size_hint_y: None
                        size: (dp(28), dp(28))
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Лечение и назначения"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        valign: "middle"

                    MDIcon:
                        icon: "chevron-right"
                        theme_icon_color: "Custom"
                        icon_color: T.GREEN
                        size_hint_x: None
                        size_hint_y: None
                        size: (dp(24), dp(24))
                        pos_hint: {"center_y": 0.5}

                # === ГАЛЕРЕЯ ФОТО ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: "34dp"

                        MDLabel:
                            text: "Галерея фото"
                            font_style: "Title"
                            role: "small"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: T.GREEN

                        MDIconButton:
                            icon: "image-plus-outline"
                            theme_icon_color: "Custom"
                            icon_color: T.GREEN
                            on_release: root.add_photo()

                    MDGridLayout:
                        id: photos_box
                        cols: 4
                        adaptive_height: True
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                # === ГАЛЕРЕЯ ВИДЕО (список клипов; плеер открывается
                # на весь экран по тапу, грузится только при просмотре) ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: "34dp"

                        MDLabel:
                            text: "Видео"
                            font_style: "Title"
                            role: "small"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: T.GREEN

                        MDIconButton:
                            icon: "video-plus-outline"
                            theme_icon_color: "Custom"
                            icon_color: T.GREEN
                            on_release: root.add_video()

                    MDBoxLayout:
                        id: videos_box
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

                # === ЛЕКАРСТВА ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDLabel:
                        text: "Лекарства"
                        font_style: "Title"
                        role: "small"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        size_hint_y: None
                        height: "30dp"

                    MDBoxLayout:
                        id: meds_box
                        orientation: "vertical"
                        adaptive_height: True

                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: dp(8)

                        MDTextField:
                            id: med_title
                            mode: "filled"
                            size_hint_x: 0.65
                            MDTextFieldHintText:
                                text: "Лекарство"
                        MDTextField:
                            id: med_time
                            mode: "filled"
                            size_hint_x: 0.3
                            MDTextFieldHintText:
                                text: "09:30"
                        MDButton:
                            style: "filled"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.add_med()
                            MDButtonText:
                                text: "OK"

                # === КОРМЛЕНИЕ ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: "34dp"

                        MDLabel:
                            text: "Кормление"
                            font_style: "Title"
                            role: "small"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: T.GREEN

                        MDIconButton:
                            icon: "calculator-variant-outline"
                            theme_icon_color: "Custom"
                            icon_color: T.GREEN
                            on_release: root.toggle_nutr()

                    MDBoxLayout:
                        id: nutr_box
                        orientation: "vertical"
                        adaptive_height: True

                    MDBoxLayout:
                        id: feed_box
                        orientation: "vertical"
                        adaptive_height: True

                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: dp(8)

                        MDTextField:
                            id: feed_time
                            mode: "filled"
                            size_hint_x: 0.28
                            MDTextFieldHintText:
                                text: "18:00"
                        MDTextField:
                            id: feed_note
                            mode: "filled"
                            size_hint_x: 0.62
                            MDTextFieldHintText:
                                text: "Рацион"
                        MDButton:
                            style: "filled"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.add_feeding()
                            MDButtonText:
                                text: "OK"

                # === ДИЕТА ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDBoxLayout:
                        size_hint_y: None
                        height: "34dp"

                        MDLabel:
                            text: "Диета"
                            font_style: "Title"
                            role: "small"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: T.GREEN

                        MDIconButton:
                            icon: "lightbulb-on-outline"
                            theme_icon_color: "Custom"
                            icon_color: T.GREEN
                            on_release: root.toggle_diet_reco()

                    MDBoxLayout:
                        id: diet_reco_box
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)

                    MDBoxLayout:
                        id: diet_box
                        orientation: "vertical"
                        adaptive_height: True

                    # форма: ряд 1 — название на всю ширину
                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"

                        MDTextField:
                            id: diet_title
                            mode: "filled"
                            size_hint_x: 1
                            MDTextFieldHintText:
                                text: "Название рациона"

                    # форма: ряд 2 — срок, время, кнопка
                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: dp(8)

                        MDTextField:
                            id: diet_days
                            mode: "filled"
                            size_hint_x: 0.28
                            input_filter: "int"
                            MDTextFieldHintText:
                                text: "Дней"
                        MDTextField:
                            id: diet_times
                            mode: "filled"
                            size_hint_x: 0.55
                            MDTextFieldHintText:
                                text: "08:00, 20:00"
                        MDButton:
                            style: "filled"
                            pos_hint: {"center_y": 0.5}
                            on_release: root.create_diet()
                            MDButtonText:
                                text: "Начать"

                # === ВЕС (список замеров; Canvas-график убран по
                # решению владельца — отображался некорректно) ===
                MDCard:
                    orientation: "vertical"
                    md_bg_color: T.CARD
                    line_color: T.CARD_BORDER
                    elevation: 0
                    radius: [dp(16)]
                    padding: dp(14)
                    size_hint_x: 0.94
                    pos_hint: {"center_x": 0.5}
                    size_hint_y: None
                    adaptive_height: True
                    spacing: dp(8)

                    MDLabel:
                        text: "Вес и замеры"
                        font_style: "Title"
                        role: "small"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: T.GREEN
                        size_hint_y: None
                        height: "30dp"

                    MDLabel:
                        id: l_last_weight
                        text: "Замеров пока нет"
                        font_size: "13sp"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_MAIN
                        size_hint_y: None
                        height: max(dp(22), self.texture_size[1])
                        text_size: (self.width - dp(8), None)

                    MDLabel:
                        id: l_weight_stats
                        text: ""
                        font_size: "12sp"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_SUB
                        size_hint_y: None
                        height: max(dp(18), self.texture_size[1])
                        text_size: (self.width - dp(8), None)

                    MDBoxLayout:
                        id: weights_list
                        orientation: "vertical"
                        adaptive_height: True

                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        spacing: dp(8)

                        MDTextField:
                            id: weight_input
                            mode: "filled"
                            size_hint_x: 0.55
                            input_filter: "float"
                            MDTextFieldHintText:
                                text: "Вес сегодня, кг"
                        MDButton:
                            style: "filled"
                            size_hint_x: 0.4
                            pos_hint: {"center_y": 0.5}
                            on_release: root.add_weight()
                            MDButtonText:
                                text: "Записать"

                # === ЮРИДИЧЕСКАЯ СТРОЧКА ===
                MDLabel:
                    text: "Приложение носит ознакомительный характер и не заменяет консультацию ветеринарного специалиста"
                    halign: "center"
                    font_style: "Label"
                    role: "medium"
                    theme_text_color: "Custom"
                    text_color: T.TEXT_SUB
                    size_hint_y: None
                    height: "36dp"
                    text_size: (self.width - dp(40), None)
                    pos_hint: {"center_x": 0.5}
