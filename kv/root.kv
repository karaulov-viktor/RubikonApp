# root.kv — RubikonApp (объединённый: спринты 1-2.6 + «Питомцы»)
# Экраны: splash, disclaimer (новый), catalog, drug_detail, profile,
# pet_form, pet_detail (личная страница), pet_treatment (лечение,
# бывший pet_detail спринтов 1-2.6), appointment_detail, calculator,
# calendar.
# Белая нижняя панель — явный md_bg_color (урок чёрного навбара на
# KivyMD 2.0.1.dev0 у пользователя).

MDBoxLayout:
    orientation: "vertical"

    ScreenManager:
        id: screen_manager

        SplashScreen:
            name: "splash"

        DisclaimerScreen:
            name: "disclaimer"

        CatalogScreen:
            name: "catalog"

        DrugDetailScreen:
            name: "drug_detail"

        ProfileScreen:
            name: "profile"

        PetFormScreen:
            name: "pet_form"

        PetDetailScreen:
            name: "pet_detail"

        MediaViewerScreen:
            name: "media_viewer"

        PetTreatmentScreen:
            name: "pet_treatment"

        AppointmentDetailScreen:
            name: "appointment_detail"

        CalculatorScreen:
            name: "calculator"

        CalendarScreen:
            name: "calendar"

    MDNavigationBar:
        id: nav_bar
        md_bg_color: 1, 1, 1, 1
        on_switch_tabs: app.on_switch_tabs(*args)

        MDNavigationItem:
            active: True

            MDNavigationItemIcon:
                icon: "magnify"

            MDNavigationItemLabel:
                text: "Каталог"

        MDNavigationItem:

            MDNavigationItemIcon:
                icon: "account"

            MDNavigationItemLabel:
                text: "Профиль"

        MDNavigationItem:

            MDNavigationItemIcon:
                icon: "calculator"

            MDNavigationItemLabel:
                text: "Калькулятор"

        MDNavigationItem:

            MDNavigationItemIcon:
                icon: "calendar"

            MDNavigationItemLabel:
                text: "Календарь"
