#:import T models.theme

<ProfileScreen>:
    md_bg_color: T.BG

    FloatLayout:

        MDBoxLayout:
            orientation: "vertical"

            MDBoxLayout:
                size_hint_y: None
                height: "56dp"
                padding: [dp(16), 0]

                MDLabel:
                    text: "Мои питомцы"
                    font_style: "Headline"
                    role: "medium"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: T.GREEN
                    valign: "middle"

            ScrollView:
                do_scroll_x: False
                bar_width: 4

                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    padding: [dp(12), dp(4), dp(12), dp(90)]
                    spacing: dp(10)

                    MDLabel:
                        id: empty_lbl
                        text: "Питомцев пока нет"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: T.TEXT_SUB
                        size_hint_y: None
                        height: "60dp"
                        opacity: 0

                    MDBoxLayout:
                        id: pets_box
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(10)

            # Системные уведомления — кнопка над меню
            MDCard:
                size_hint_y: None
                height: "48dp"
                md_bg_color: T.GREEN_SOFT
                radius: [0]
                MDButton:
                    id: btn_sysnotify
                    style: "text"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    on_release: app.toggle_system_notifications()
                    MDButtonText:
                        text: "Включить напоминания при закрытом приложении"
                        theme_text_color: "Custom"
                        text_color: T.GREEN

        # FAB поверх экрана (не в потоке лэйаута)
        MDFabButton:
            icon: "plus"
            style: "standard"
            size_hint: None, None
            size: "56dp", "56dp"
            pos_hint: {"right": 0.94, "y": 0.04}
            on_release: app.add_pet()
