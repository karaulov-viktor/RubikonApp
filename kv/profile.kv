#:import my_hex kivy.utils.get_color_from_hex

<ProfileScreen>:
    md_bg_color: 1, 1, 1, 1

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(12), dp(16), dp(12), dp(70)
        spacing: dp(12)

        # Заголовок
        MDLabel:
            text: 'Мои питомцы'
            halign: 'center'
            font_style: "Title"
            role: "large"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: 0.18, 0.49, 0.2, 1
            bold: True

        # Список карточек
        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                id: cards_box
                orientation: 'vertical'
                adaptive_height: True
                spacing: dp(10)

    # Плавающая кнопка добавления
    MDFabButton:
        icon: "plus"
        style: "standard"
        pos_hint: {"right": 0.95, "y": 0.05}
        md_bg_color: 0.18, 0.49, 0.2, 1
        on_release: root.manager.current = 'pet_form'