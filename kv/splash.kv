#:import T models.theme

<SplashScreen>:
    md_bg_color: T.SPLASH

    Image:
        source: 'img/logo.png'
        size_hint: (None, None)
        size: (200, 200)
        pos_hint: {'center_x': 0.5, 'center_y': 0.55}

    MDLabel:
        text: "Рубиконт-Агент"
        halign: "center"
        theme_text_color: "Custom"
        text_color: T.SPLASH_TEXT
        font_style: "Headline"
        role: "large"
        pos_hint: {'center_x': 0.5, 'center_y': 0.35}

    MDLabel:
        text: "Ветеринарный помощник"
        halign: "center"
        theme_text_color: "Custom"
        text_color: T.SPLASH_TEXT
        font_style: "Title"
        role: "medium"
        pos_hint: {"center_x": 0.5, "center_y": 0.28}