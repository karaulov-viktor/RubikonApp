# Калькулятор дозировок — RubikonApp
#
# Редизайн «PetsHealth»:
#   - фон экрана: светлый #F3F7FA через canvas.before
#     (НЕ app.theme_cls.backgroundColor — в сборке KivyMD на машинах
#     пользователя он разрешается в чёрный);
#   - шапка прозрачная на фоне, тёмный заголовок, серый подзаголовок;
#   - поля в белой карточке с тонкой рамкой;
#   - акценты бирюзовые #2FA5C5, результат — мятная карточка.
#
# ВАЖНО (правила проекта):
#   - только ПРОБЕЛЫ, 4 пробела на уровень вложенности (табы запрещены!)
#   - составные виджеты KivyMD 2.0.1.dev0: тексты полей и кнопок —
#     обязательно вложенные классы (MDTextFieldHintText, MDButtonText)

#:import C models.theme

<CalculatorScreen>
    id: calculator_screen
    # Явный светлый фон, рисуется ПОД содержимым (canvas.before)
    canvas.before:
        Color:
            rgba: C.BG
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"

        # ----------------------------------------------------------
        # Шапка — тёмный заголовок, серый подзаголовок
        # ----------------------------------------------------------
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(16), dp(14)
            spacing: dp(2)
            md_bg_color: C.BG

            MDLabel:
                text: "Калькулятор дозировок"
                font_style: "Title"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: C.TEXT_MAIN

            MDLabel:
                text: "Разовая доза и объём препарата для инъекции"
                font_style: "Body"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: C.TEXT_SUB

        MDDivider:
            size_hint_y: None
            height: dp(1)

        # ----------------------------------------------------------
        # Содержимое (прокручивается на маленьких экранах)
        # ----------------------------------------------------------
        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(14)

                # Формула-подсказка: из чего складывается расчёт
                MDLabel:
                    text: "Объём, мл = Вес, кг × Доза, мг/кг ÷ Концентрация, мг/мл"
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: C.TEXT_SUB

                # --------------------------------------------------
                # Блок ввода (белая карточка с тонкой рамкой)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(10)
                    md_bg_color: C.CARD
                    line_color: C.CARD_BORDER
                    radius: [dp(14)]
                    padding: dp(14)

                    MDTextField:
                        id: weight_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "weight-kilogram"

                        MDTextFieldHintText:
                            text: "Вес животного, кг"

                    MDTextField:
                        id: dose_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "medical-bag"

                        MDTextFieldHintText:
                            text: "Дозировка препарата, мг/кг"

                    MDTextField:
                        id: conc_field
                        mode: "filled"

                        MDTextFieldLeadingIcon:
                            icon: "test-tube"

                        MDTextFieldHintText:
                            text: "Концентрация препарата, мг/мл"

                # --------------------------------------------------
                # Кнопки
                # --------------------------------------------------
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(12)

                    MDButton:
                        style: "filled"
                        theme_bg_color: "Custom"
                        md_bg_color: C.PRIMARY
                        on_release: root.calculate()

                        MDButtonText:
                            text: "Рассчитать"
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                    MDButton:
                        style: "text"
                        on_release: root.reset()

                        MDButtonText:
                            text: "Сбросить"
                            theme_text_color: "Custom"
                            text_color: C.PRIMARY

                # --------------------------------------------------
                # Ошибка (видна только когда error_text непустой;
                # высота 0 без ошибки — чтобы не оставлять дыру в макете)
                # --------------------------------------------------
                MDLabel:
                    text: root.error_text
                    font_style: "Body"
                    theme_text_color: "Custom"
                    text_color: C.DANGER
                    opacity: 1 if root.error_text else 0
                    size_hint_y: None
                    height: dp(22) if root.error_text else 0

                # --------------------------------------------------
                # Результат (мятная карточка)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(4)
                    md_bg_color: C.MINT_BG
                    radius: [dp(14)]
                    padding: dp(16)

                    MDLabel:
                        text: "Нужно действующего вещества"
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB

                    MDLabel:
                        text: root.result_mg
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.MINT_TEXT

                    MDLabel:
                        text: "Объём препарата в шприц"
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB

                    MDLabel:
                        text: root.result_ml
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.MINT_TEXT

                # Совет под результатом
                MDLabel:
                    text: "Совет: набирайте шприц подходящего объёма и сверяйтесь с инструкцией к препарату."
                    font_style: "Body"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: C.TEXT_SUB
