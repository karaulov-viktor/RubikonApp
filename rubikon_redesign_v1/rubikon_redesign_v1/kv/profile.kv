#:import C models.theme

<ProfileScreen>:
    md_bg_color: C.BG

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16), dp(16), dp(16), dp(70)
        spacing: dp(12)

        # Заголовок секции — слева, тёмный (стиль PetsHealth)
        MDLabel:
            text: 'Мои питомцы'
            halign: 'left'
            font_style: "Title"
            role: "large"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: C.TEXT_MAIN
            bold: True

        # Список карточек
        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                id: cards_box
                orientation: 'vertical'
                adaptive_height: True
                spacing: dp(10)

    # Плавающая кнопка добавления — бирюзовая
    MDFabButton:
        icon: "plus"
        style: "standard"
        pos_hint: {"right": 0.95, "y": 0.05}
        md_bg_color: C.PRIMARY
        on_release: root.open_create_form()
