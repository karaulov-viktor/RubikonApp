# Карточка препарата — RubikonApp
#
# Редизайн «PetsHealth»:
#   - фон экрана: светлый #F3F7FA через canvas.before. НЕ используем
#     app.theme_cls.backgroundColor — в сборке KivyMD 2.0.1.dev0 на машинах
#     пользователя он разрешается в ЧЁРНЫЙ;
#   - шапка белая, тёмные текст и стрелка;
#   - блоки — белые карточки с тонкой рамкой;
#   - акценты бирюзовые #2FA5C5; дисклеймер — янтарный.
#
# ВАЖНО (правила проекта):
#   - только ПРОБЕЛЫ, 4 пробела на уровень вложенности (табы запрещены!)
#   - сохранены ВСЕ прежние id: drug_image, drug_name, drug_category,
#     drug_description, drug_instruction (drug_detail.py совместим)
#   - добавлены только id detail_scroll и calc_button
#   - name: "drug_detail" — на случай, если root.kv не задаёт имя экрана;
#     если задаёт, значение то же самое — конфликта нет
#
# Кнопка «Рассчитать дозу» ведёт на экран калькулятора
# (root.manager.current), а не на заглушку app.calculate_dose().

#:import C models.theme

<DrugDetailScreen>
    name: "drug_detail"
    # Явный светлый фон, рисуется ПОД содержимым (canvas.before).
    canvas.before:
        Color:
            rgba: C.BG
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"

        # ----------------------------------------------------------
        # Шапка — белая, тёмные текст и стрелка, снизу тонкая линия
        # ----------------------------------------------------------
        MDBoxLayout:
            orientation: "horizontal"
            adaptive_height: True
            padding: dp(8), dp(6)
            spacing: dp(4)
            md_bg_color: C.CARD

            MDIconButton:
                icon: "arrow-left"
                icon_color: C.TEXT_MAIN
                pos_hint: {"center_y": 0.5}
                on_release: root.go_back()

            MDLabel:
                text: "Карточка препарата"
                font_style: "Title"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: C.TEXT_MAIN
                pos_hint: {"center_y": 0.5}

        MDDivider:
            size_hint_y: None
            height: dp(1)

        # ----------------------------------------------------------
        # Содержимое (прокручивается)
        # ----------------------------------------------------------
        ScrollView:
            id: detail_scroll

            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(16)
                spacing: dp(14)

                # Фото препарата (белая карточка с рамкой)
                MDBoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: dp(220)
                    md_bg_color: C.CARD
                    line_color: C.CARD_BORDER
                    radius: [dp(14)]

                    Image:
                        id: drug_image
                        source: ""
                        fit_mode: "contain"   # фото не режем (правило BUG-4)
                        size_hint: 1, 1

                # Название и категория
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(2)

                    MDLabel:
                        id: drug_name
                        text: ""
                        font_style: "Headline"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_MAIN

                    MDLabel:
                        id: drug_category
                        text: ""
                        font_style: "Body"
                        role: "small"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_SUB

                # --------------------------------------------------
                # Инструкция (разметка из БД: [b], [color], «•», \n)
                # белая карточка с рамкой; цвета заголовков задаёт
                # сама разметка из БД (см. recolor_drug_markup.sql)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "vertical"
                    adaptive_height: True
                    spacing: dp(6)
                    md_bg_color: C.CARD
                    line_color: C.CARD_BORDER
                    radius: [dp(14)]
                    padding: dp(14)

                    MDLabel:
                        id: drug_instruction
                        text: ""
                        markup: True
                        font_style: "Body"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.TEXT_MAIN

                # --------------------------------------------------
                # Кнопка «Рассчитать дозу» — переход на экран калькулятора.
                # Раньше кнопка дёргала заглушку app.calculate_dose() из
                # main.py (только print). Теперь — реальная навигация.
                # --------------------------------------------------
                MDButton:
                    id: calc_button
                    style: "filled"
                    # Custom — иначе стиль "filled" игнорирует md_bg_color
                    # и красит кнопку цветом темы (см. button.kv KivyMD)
                    theme_bg_color: "Custom"
                    md_bg_color: C.PRIMARY
                    on_release: root.manager.current = "calculator"

                    MDButtonIcon:
                        icon: "calculator"
                        icon_color: 1, 1, 1, 1

                    MDButtonText:
                        text: "Рассчитать дозу"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                # --------------------------------------------------
                # Дисклеймер (юридическая подушка — см. обсуждение
                # «скан vs текст»: текст легитимен при ссылке
                # на оригинал и реквизитах утверждения)
                # --------------------------------------------------
                MDBoxLayout:
                    orientation: "horizontal"
                    adaptive_height: True
                    spacing: dp(10)
                    padding: dp(12)
                    md_bg_color: C.AMBER_BG
                    radius: [dp(14)]

                    MDIcon:
                        icon: "information"
                        font_size: "22sp"
                        size_hint_x: None
                        width: dp(26)
                        pos_hint: {"center_y": 0.5}
                        theme_text_color: "Custom"
                        text_color: C.AMBER_ICON

                    MDLabel:
                        text: "Информация носит справочный характер. Перед применением ознакомьтесь с оригиналом инструкции, утверждённой производителем."
                        font_style: "Body"
                        role: "small"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: C.AMBER_TEXT
